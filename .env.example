# PocketBase superuser: create once with `docker compose exec pocketbase ... superuser create ...`
PB_SUPERUSER_EMAIL=admin@local-git.test
PB_SUPERUSER_PASSWORD=change-this-to-a-long-random-password

# Generate with: openssl rand -hex 32. Keep stable; changing it revokes all PATs.
TOKEN_PEPPER=replace-with-at-least-32-random-bytes-in-hex

# Container-to-container URL (do not change for Compose)
PB_URL_INTERNAL=http://pocketbase:8090

# Browser-visible URLs (must be reachable from the machine running the browser)
NEXT_PUBLIC_PB_URL=http://127.0.0.1:8090
NEXT_PUBLIC_GIT_ENGINE_URL=http://127.0.0.1:3200

# URL written into clone URLs
PUBLIC_GIT_BASE_URL=http://127.0.0.1:3200

# Git Engine
GIT_DATA_DIR=/data/git
GIT_ENGINE_PORT=3200
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web
WEB_PORT=3000
