{
  "identifier": "com.sovereign.desktop",
  "productName": "Sovereign Desktop",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sovereign Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http://localhost:* ws://localhost:*;"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["msix"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ],
    "publisher": "CN=Sovereign",
    "msix": {
      "identityName": "Sovereign.Desktop",
      "displayName": "Sovereign Desktop",
      "publisherDisplayName": "Sovereign Team",
      "minimumVersion": "10.0.17763.0"
    },
    "externalBin": [
      "bin/git-engine.exe",
      "bin/arsy.exe",
      "bin/legend.exe",
      "bin/pocketbase.exe",
      "bin/radius.exe"
    ]
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": [
          { "path": "$APPDATA/Sovereign/**" },
          { "path": "$HOME/**" }
        ]
      }
    },
    "shell": {
      "scope": {
        "allow": [
          { "name": "git-engine", "cmd": "bin/git-engine.exe", "args": true },
          { "name": "arsy", "cmd": "bin/arsy.exe", "args": true },
          { "name": "legend", "cmd": "bin/legend.exe", "args": true },
          { "name": "pocketbase", "cmd": "bin/pocketbase.exe", "args": true },
          { "name": "radius", "cmd": "bin/radius.exe", "args": true }
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/sovereign/sovereign-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "allowlist": {
    "fs": {
      "readFile": true,
      "writeFile": true,
      "readDir": true,
      "copyFile": true,
      "createDir": true,
      "removeFile": true,
      "removeDir": true,
      "renameFile": true,
      "exists": true
    },
    "shell": {
      "open": true,
      "execute": true,
      "sidecar": true
    },
    "process": {
      "relaunch": true,
      "exit": true
    },
    "dialog": {
      "open": true,
      "save": true,
      "message": true,
      "ask": true
    },
    "notification": {
      "show": true
    },
    "clipboard": {
      "readText": true,
      "writeText": true
    }
  }
}
